# Copy to .env.local (or .env) and fill in from Supabase → Project Settings → API
# Use the publishable key (sb_publishable_...), never the secret key.
# The VITE_ prefix is required: Vite only exposes VITE_* variables to the browser.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
