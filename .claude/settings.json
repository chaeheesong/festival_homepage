{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.test)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.*.local)",
      "Edit(./.env.development)",
      "Edit(./.env.production)",
      "Edit(./.env.test)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r \".tool_input.command // empty\" | grep -Eq \"\\.env(\\.(local|development|production|test)(\\.local)?)?([^A-Za-z0-9._-]|$)\" && { echo \"Blocked: .env files hold secrets and are off-limits to Claude (see .claude/settings.json).\" >&2; exit 2; } || exit 0",
            "statusMessage": "Checking for .env access"
          }
        ]
      }
    ]
  }
}
